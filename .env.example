# Copy to .env and adjust. These are loaded before environment variables,
# so real environment variables always win.

# Server
GATEWAY_HTTP_ADDR=:8080
GATEWAY_GRPC_ADDR=:9090

# Layer 1 Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_REQUEST_TIMEOUT=5s
OLLAMA_RETRY_ATTEMPTS=1
